{
  "task_version": "1.0",
  "task_id": "agentic-public-research-demo",
  "business_profile": "configs/example-business/business-profile.json",
  "objective": "Explore approved public webpages with read-only navigation and produce evidence-backed findings without login, form interaction, downloads, or state-changing actions.",
  "mode": "research-only",
  "approved_domains": [
    "example.com",
    "example.org"
  ],
  "prohibited_actions": [
    "login",
    "send",
    "publish",
    "purchase",
    "delete",
    "change-permissions",
    "upload-confidential-data",
    "bypass-access-controls"
  ],
  "inputs": {
    "start_urls": [
      "https://example.com/",
      "https://example.org/"
    ],
    "keywords": ["public information"],
    "selectors": {},
    "date_range": "current public information",
    "notes": "Browser Use eligible only after explicit routing opt-in and blueprint approval."
  },
  "outputs": {
    "formats": [
      "json",
      "markdown",
      "screenshots"
    ],
    "destination": "artifacts/agentic-public-research-demo/",
    "require_source_urls": true,
    "require_timestamps": true,
    "required_fields": [
      "name",
      "summary",
      "source_url",
      "accessed_at"
    ]
  },
  "limits": {
    "max_items": 10,
    "max_retries": 1,
    "timeout_minutes": 15
  },
  "approval_policy": {
    "require_blueprint_confirmation": true,
    "require_test_approval": true,
    "consequential_actions": []
  },
  "validation": {
    "success_criteria": [
      "Every result contains a source URL and access timestamp",
      "Only approved public domains are visited",
      "Failures and missing values are reported"
    ],
    "duplicate_key": "source_url",
    "on_missing_data": "include-null-and-report"
  }
}
