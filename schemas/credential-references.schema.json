{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/credential-references.schema.json",
  "title": "Tharhtet Browser Agent Client Credential References",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "client_id",
    "environment",
    "provider",
    "bindings",
    "adapters"
  ],
  "properties": {
    "config_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "client_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "environment": {
      "enum": ["development", "test", "production"]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "service_identity", "allowed_vaults"],
      "properties": {
        "type": {"const": "1password-cli"},
        "service_identity": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"
        },
        "allowed_vaults": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,79}$"
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "environment_variable", "reference"],
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
          },
          "environment_variable": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,79}$"
          },
          "reference": {
            "type": "string",
            "pattern": "^op://[A-Za-z0-9][A-Za-z0-9._-]{1,79}/[A-Za-z0-9][A-Za-z0-9._-]{1,79}/[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          }
        }
      }
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter_id", "command", "required_capabilities"],
        "properties": {
          "adapter_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,62}$"
          },
          "command": {
            "enum": ["uba-notion-read"]
          },
          "required_capabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
            }
          }
        }
      }
    }
  }
}
