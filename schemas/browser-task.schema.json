{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/browser-task.schema.json",
  "title": "Universal Browser Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_version", "task_id", "business_profile", "objective", "mode", "approved_domains", "inputs", "outputs", "limits", "approval_policy", "validation"],
  "properties": {
    "task_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
    "business_profile": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.json$"},
    "objective": {"type": "string", "minLength": 12, "maxLength": 1000},
    "mode": {"enum": ["research-only", "draft-only", "test", "production"]},
    "approved_domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?:[a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,}$"}
    },
    "prohibited_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["login", "send", "publish", "purchase", "delete", "change-permissions", "upload-confidential-data", "bypass-access-controls"]},
      "default": ["bypass-access-controls"]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true,
      "minProperties": 1
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "destination", "require_source_urls", "require_timestamps"],
      "properties": {
        "formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["json", "csv", "markdown", "html", "pdf", "screenshots"]}},
        "destination": {"type": "string", "minLength": 2, "maxLength": 240},
        "require_source_urls": {"type": "boolean"},
        "require_timestamps": {"type": "boolean"},
        "required_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_items", "max_retries", "timeout_minutes"],
      "properties": {
        "max_items": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 5},
        "timeout_minutes": {"type": "integer", "minimum": 1, "maximum": 360}
      }
    },
    "approval_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["require_blueprint_confirmation", "require_test_approval", "consequential_actions"],
      "properties": {
        "require_blueprint_confirmation": {"const": true},
        "require_test_approval": {"type": "boolean"},
        "consequential_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["send", "publish", "purchase", "delete", "submit", "change-permissions", "upload-confidential-data", "accept-terms"]}
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success_criteria", "duplicate_key", "on_missing_data"],
      "properties": {
        "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
        "duplicate_key": {"type": "string", "minLength": 1},
        "on_missing_data": {"enum": ["fail", "skip-and-report", "include-null-and-report"]}
      }
    }
  }
}
