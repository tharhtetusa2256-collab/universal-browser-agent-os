# Generate a unique value, for example: openssl rand -hex 32
UBA_API_TOKEN=replace-with-at-least-24-random-characters

UBA_REPO_ROOT=/app
UBA_DATABASE_PATH=/app/service-data/browser-agent.sqlite3
UBA_WORKER_POLL_SECONDS=2
# Safely exceeds the current maximum browser-task timeout of 360 minutes.
UBA_STALE_RUN_MINUTES=480

# Optional OpenRouter planning preview
OPENROUTER_API_KEY=
UBA_OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional Notion Execution Runs output
NOTION_API_KEY=
UBA_NOTION_DATABASE_ID=
UBA_NOTION_TITLE_PROPERTY=Name

# Optional Notion data-source reader. Use a separate internal integration with
# read-content capability only. Do not reuse a write-capable output token.
UBA_NOTION_READ_TOKEN=

# Optional Make.com or other HTTPS webhook output
UBA_OUTBOUND_WEBHOOK_URL=
UBA_OUTBOUND_WEBHOOK_SECRET=
