{
  "config_version": "1.0",
  "client_id": "tech-power",
  "environment": "development",
  "provider": {
    "type": "1password-cli",
    "service_identity": "sa-tech-power-dev-read",
    "allowed_vaults": ["Client-Tech-Power-Dev"]
  },
  "bindings": [
    {
      "capability": "notion.read",
      "environment_variable": "UBA_NOTION_READ_TOKEN",
      "reference": "op://Client-Tech-Power-Dev/Notion-Read-Connector/credential"
    }
  ],
  "adapters": [
    {
      "adapter_id": "notion-read",
      "command": "uba-notion-read",
      "required_capabilities": ["notion.read"]
    }
  ]
}
